# ============================================================
# MedGemma CDS Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values

# --- MedGemma Configuration ---
# Choose ONE backend below and uncomment its block.
#
# Option A: Google AI Studio (OpenAI-compatible API):
MEDGEMMA_API_KEY=your_api_key_here
MEDGEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MEDGEMMA_MODEL_ID=google/medgemma-27b-text-it

# Option B: HuggingFace Inference Endpoint (TGI). The model name is literally "tgi":
# MEDGEMMA_API_KEY=hf_your_token_here
# MEDGEMMA_BASE_URL=https://YOUR_ENDPOINT.endpoints.huggingface.cloud/v1
# MEDGEMMA_MODEL_ID=tgi

# Option C: Local Hugging Face transformers (no API):
# MEDGEMMA_DEVICE=cuda  # or cpu, mps
# MEDGEMMA_MODEL_ID=google/medgemma-4b-it

# --- External API Configuration ---
# OpenFDA (no key required for basic use, add for higher rate limits)
# OPENFDA_API_KEY=

# HuggingFace token (for downloading datasets without rate limits)
# Get yours at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# --- RAG Configuration ---
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Agent Configuration ---
AGENT_MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_STEPS=10
DEFAULT_INCLUDE_DRUG_CHECK=true
DEFAULT_INCLUDE_GUIDELINES=true
