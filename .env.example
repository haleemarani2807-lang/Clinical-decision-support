# ==============================================================================
# Evidence-Verified CDSS — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in the values.
# cp .env.example .env
#
# NEVER commit your .env file to version control.
# All variables marked [OPTIONAL] have sensible defaults.
# ==============================================================================

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Default provider is Ollama (local, free). Change in model_config.yaml.

# Ollama – local LLM server (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434        # [OPTIONAL] default shown

# MedGemma via HuggingFace Dedicated Endpoint [OPTIONAL]
# Only needed if you switch model_config.yaml provider to "medgemma"
MEDGEMMA_API_KEY=
MEDGEMMA_BASE_URL=
MEDGEMMA_MODEL_ID=tgi

# Generic OpenAI-compatible endpoint [OPTIONAL]
# e.g. LM Studio, vLLM, Groq
LLM_API_KEY=

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required for downloading private models or gated datasets
HF_TOKEN=                                    # [OPTIONAL]

# ── External Medical APIs ─────────────────────────────────────────────────────
# All are optional — free tiers work without keys (with rate limits)
PUBMED_API_KEY=                              # 10 req/s with key vs 3/s without
OPENFDA_API_KEY=                             # 240 req/min with key vs 40/min
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST   # [OPTIONAL] default shown

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero-setup) — just leave as-is for local development
DATABASE_URL=sqlite:///./data/cdss.db

# PostgreSQL (optional — requires running postgres, e.g. via docker-compose --profile pg)
# DATABASE_URL=postgresql://cdss:cdss_local_dev@localhost:5432/cdss

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma             # [OPTIONAL] default shown
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2  # [OPTIONAL]

# ── Model Config ──────────────────────────────────────────────────────────────
MODEL_CONFIG_PATH=./model_config.yaml        # [OPTIONAL] default shown

# ── Application Settings ──────────────────────────────────────────────────────
DEBUG=true
PRIVACY_MODE=false                           # set true to disable case retention
AGENT_TIMEOUT_SECONDS=300

# ── Kaggle (for dataset downloads) ────────────────────────────────────────────
# Place your kaggle.json at ~/.kaggle/kaggle.json (standard Kaggle CLI location)
# Or set these environment variables:
KAGGLE_USERNAME=                             # [OPTIONAL]
KAGGLE_KEY=                                  # [OPTIONAL]

# ── Evaluation ────────────────────────────────────────────────────────────────
EVAL_RESULTS_DIR=./experiments/results      # [OPTIONAL]
EVAL_MAX_CASES=50                            # [OPTIONAL] cases per eval run
